---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ToolMotion from "@/components/ToolMotion.astro";
import { aboutParagraphs } from "@/content/about";
import { siteConfig } from "@/lib/site";
---

<BaseLayout title="회사소개" description={`${siteConfig.companyName} 소개`}>
  <PageHeader eyebrow="회사소개" title="당진에서 설비 일을 합니다" />

  <section class="relative mx-auto max-w-2xl px-4 py-14 sm:px-6 sm:py-16">
    <ToolMotion tool="wrench" side="right" />
    <div class="space-y-5">
      {aboutParagraphs.map((p) => <p class="text-base leading-[1.9] text-ink-muted sm:text-lg">{p}</p>)}
    </div>

    <dl class="mt-10 grid gap-5 rounded-md border border-border bg-surface p-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-ink-muted">대표</dt>
        <dd class="mt-1 font-semibold text-ink">{siteConfig.ceoName}</dd>
      </div>
      <div>
        <dt class="text-sm text-ink-muted">등록업체</dt>
        <dd class="mt-1 font-semibold text-ink">{siteConfig.registrations.join(", ")}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm text-ink-muted">일하는 곳</dt>
        <dd class="mt-1 font-semibold text-ink">{siteConfig.address}</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
