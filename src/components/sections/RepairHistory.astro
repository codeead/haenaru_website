---
import { getCollection } from "astro:content";
import WorkCard from "@/components/WorkCard.astro";

const allWorks = await getCollection("works", ({ data }) => !data.draft);
const recentWorks = allWorks
  .sort((a, b) => b.data.workedAt.getTime() - a.data.workedAt.getTime())
  .slice(0, 3);
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
  <div class="flex items-end justify-between">
    <div>
      <h2 class="text-xl font-bold tracking-[-0.01em] text-foreground sm:text-2xl">최근 수리 이력</h2>
      <p class="mt-1.5 text-sm text-foreground-muted">현장에서 직접 진행한 시공 사례입니다</p>
    </div>
    <a href="/works" class="shrink-0 text-sm font-medium text-primary">전체보기 →</a>
  </div>

  {
    recentWorks.length > 0 ? (
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {recentWorks.map((work) => <WorkCard work={work} />)}
      </div>
    ) : (
      <div class="mt-8 rounded-lg border border-dashed border-border bg-surface px-6 py-14 text-center">
        <p class="text-sm text-foreground-muted">등록된 수리 이력이 곧 표시됩니다.</p>
      </div>
    )
  }
</section>
