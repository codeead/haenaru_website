# Variable names only — never commit real values.
# Local values go in `.dev.vars` (gitignored). Production secrets via `wrangler secret put`.

# Kakao Maps SDK + Channel chat button (exposed to the client)
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_KAKAO_CHANNEL_PUBLIC_ID=

# Kakao Local API (server-side reverse geocoding)
KAKAO_REST_KEY=

# Used for sitemap.xml / robots.txt absolute URLs
NEXT_PUBLIC_SITE_URL=

# Cloudflare bindings (DB = D1, BUCKET = R2) are configured in wrangler.jsonc,
# accessed via getCloudflareContext() — not via process.env.
