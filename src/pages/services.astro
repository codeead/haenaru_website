---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { services } from "@/content/services";
---

<BaseLayout title="서비스" description="해나루 종합설비가 제공하는 서비스">
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm font-medium text-primary">서비스</p>
    <h1 class="mt-2 text-[clamp(1.5rem,4vw,2.25rem)] font-bold tracking-[-0.02em] text-foreground">
      취급 업무
    </h1>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        services.map((service) => (
          <div class="rounded-lg border border-border bg-surface p-6">
            <h2 class="text-base font-semibold text-foreground">{service.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-foreground-muted">{service.description}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
