---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getServiceByKey } from "@/content/services";

interface Props {
  work: CollectionEntry<"works">;
  headingLevel?: "h2" | "h3";
  featured?: boolean;
}

const { work, headingLevel = "h3", featured = false } = Astro.props;
const { title, category, workedAt, locationRegion, coverImage } = work.data;
const categoryLabel = getServiceByKey(category)?.title ?? category;
const dateLabel = workedAt.toLocaleDateString("ko-KR", { year: "numeric", month: "long" });
const Heading = headingLevel;
---

<a
  href={`/works/${work.id}/`}
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface shadow-sm transition-transform active:scale-[0.98]",
  ]}
>
  <div class:list={["overflow-hidden bg-border", featured ? "aspect-[16/10]" : "aspect-[4/3]"]}>
    <Image
      src={coverImage}
      alt={title}
      width={featured ? 800 : 480}
      height={featured ? 500 : 360}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class:list={["flex flex-1 flex-col p-4", featured && "p-5"]}>
    <span class:list={["font-medium text-primary", featured ? "text-sm" : "text-xs"]}>{categoryLabel}</span>
    <Heading class:list={["mt-1 font-semibold leading-snug text-ink", featured ? "text-xl" : "text-base"]}>
      {title}
    </Heading>
    <p class="mt-1.5 text-sm text-ink-muted">{locationRegion} · {dateLabel}</p>
  </div>
</a>
