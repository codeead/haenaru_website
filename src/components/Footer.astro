---
import { siteConfig } from "@/lib/site";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <p class="text-base font-semibold text-foreground">{siteConfig.companyName}</p>
        <p class="mt-1 text-sm text-foreground-muted">대표 {siteConfig.ceoName}</p>
        <p class="mt-3 text-sm leading-relaxed text-foreground-muted">{siteConfig.address}</p>
      </div>
      <div class="text-sm leading-relaxed text-foreground-muted">
        <p>
          <a href={`tel:${siteConfig.mobile}`} class="hover:text-foreground">{siteConfig.mobile}</a>
          <span class="mx-1.5">·</span>
          <a href={`tel:${siteConfig.phone}`} class="hover:text-foreground">{siteConfig.phone}</a>
        </p>
        <p class="mt-1">FAX {siteConfig.fax}</p>
        <p class="mt-1">{siteConfig.businessHours}</p>
        {
          siteConfig.registrations.length > 0 && (
            <p class="mt-3 flex flex-wrap gap-1.5">
              {siteConfig.registrations.map((r) => (
                <span class="rounded-full border border-border px-2.5 py-0.5 text-xs text-foreground-muted">
                  {r}
                </span>
              ))}
            </p>
          )
        }
      </div>
    </div>

    <p class="mt-8 border-t border-border pt-5 text-xs text-foreground-muted">
      &copy; {currentYear} {siteConfig.companyName}. All rights reserved.
    </p>
  </div>
</footer>
