---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/site";

const searchUrl = `https://map.kakao.com/link/search/${encodeURIComponent(siteConfig.address)}`;
const mapEmbedUrl = `https://map.kakao.com/link/map/${encodeURIComponent(siteConfig.companyName)},${encodeURIComponent(siteConfig.address)}`;
---

<BaseLayout title="오시는 길" description={siteConfig.address}>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm font-medium text-primary">오시는 길</p>
    <h1 class="mt-2 text-[clamp(1.5rem,4vw,2.25rem)] font-bold tracking-[-0.02em] text-foreground">
      {siteConfig.companyName}
    </h1>

    <dl class="mt-8 space-y-5 rounded-lg border border-border bg-surface p-6">
      <div>
        <dt class="text-sm text-foreground-muted">주소</dt>
        <dd class="mt-1 text-base font-medium text-foreground">{siteConfig.address}</dd>
      </div>
      <div>
        <dt class="text-sm text-foreground-muted">영업시간</dt>
        <dd class="mt-1 text-base font-medium text-foreground">{siteConfig.businessHours}</dd>
      </div>
      <div>
        <dt class="text-sm text-foreground-muted">연락처</dt>
        <dd class="mt-1 text-base font-medium text-foreground">
          <a href={`tel:${siteConfig.mobile}`} class="hover:text-primary">{siteConfig.mobile}</a>
        </dd>
      </div>
    </dl>

    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      <a
        href={searchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-border bg-surface px-5 py-3 text-sm font-semibold text-foreground transition-transform active:scale-[0.97]"
      >
        카카오맵에서 보기
      </a>
      <a
        href={mapEmbedUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-transform active:scale-[0.97]"
      >
        길찾기
      </a>
    </div>
  </section>
</BaseLayout>
