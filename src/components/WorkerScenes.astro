---
/*
 * 히어로 오른쪽 작업 장면 애니메이션.
 * 곡선으로 이어 그린 작업자(흰 안전모 + 남색 망사 조끼)와 도구로 네 장면이 회전하며 순환한다.
 *   1) 배관 설계 - 미로처럼 길을 짜 나가는 배관 경로가 그려진다
 *   2) 화장실 인테리어 - 타일을 붙인다
 *   3) 누수 파이프 교체 - 천장 배관에서 물이 떨어진다
 *   4) 보일러 설치 - 벽걸이 보일러를 연결한다
 *
 * 안전모와 조끼는 <defs>에 한 번만 정의하고 장면마다 <use>로 붙인다(머리 중심 좌표 기준).
 * 장식이므로 aria-hidden. prefers-reduced-motion이면 순환을 멈추고 첫 장면만 보여준다.
 */
const SCENE_MS = 4800;
---

<div class="worker-scenes" aria-hidden="true" data-scene-ms={SCENE_MS}>
  <svg viewBox="0 0 400 380" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>

      <!-- 안전모: 위로 솟은 돔 + 챙, 흰색 -->
      <g id="gear-helmet" stroke-linecap="round" stroke-linejoin="round">
        <path d="M-27 -20 C-26 -66 26 -66 27 -20 Z" fill="var(--color-gear-helmet)" stroke="var(--color-gear-helmet-line)" stroke-width="6"></path>
        <path d="M0 -62 C1 -48 1 -34 0 -24" stroke="var(--color-gear-helmet-ridge)" stroke-width="4"></path>
        <path d="M-38 -18 C-18 -33 18 -33 38 -18 C18 -10 -18 -10 -38 -18 Z" fill="var(--color-gear-helmet)" stroke="var(--color-gear-helmet-line)" stroke-width="6"></path>
      </g>

    </defs>

    <line x1="46" y1="336" x2="354" y2="336" stroke="var(--color-sea-soft)" stroke-width="7" stroke-linecap="round" />

    <!-- 1. 배관 설계 : 미로처럼 길을 짜 나간다 -->
    <g class="scene scene-1 is-active" stroke-linecap="round" stroke-linejoin="round">
      <path class="route" d="M232 314 V254 H304 V196 H248 V142 H336" stroke="var(--color-sea)" stroke-width="13" fill="none" />
      <circle cx="304" cy="254" r="7" fill="var(--color-sea-deep)" />
      <circle cx="248" cy="196" r="7" fill="var(--color-sea-deep)" />
      <circle cx="248" cy="142" r="7" fill="var(--color-sea-deep)" />

      <g class="figure">
        <path d="M140 193 C140 216 140 250 140 272" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M140 272 C132 296 126 316 124 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M140 272 C150 296 158 314 162 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M136 212 C118 226 106 246 104 268" stroke="var(--color-ink)" stroke-width="9" />
        <path class="arm-point" d="M144 210 C176 202 202 226 224 250" stroke="var(--color-ink)" stroke-width="9" />
        <circle cx="140" cy="168" r="25" stroke="var(--color-ink)" stroke-width="9" fill="var(--color-surface)" />
        <use href="#gear-helmet" x="140" y="168"></use>
      </g>
    </g>

    <!-- 2. 화장실 인테리어 : 타일을 붙인다 -->
    <g class="scene scene-2" stroke-linecap="round" stroke-linejoin="round">
      <g stroke="var(--color-sea-soft)" stroke-width="5">
        <rect x="246" y="104" width="46" height="46" rx="12" fill="var(--color-sea-pale)" />
        <rect x="300" y="104" width="46" height="46" rx="12" fill="var(--color-sea-pale)" />
        <rect x="246" y="158" width="46" height="46" rx="12" fill="var(--color-sea-pale)" />
      </g>
      <rect class="tile-place" x="300" y="158" width="46" height="46" rx="12" fill="var(--color-sunset-soft)" stroke="var(--color-sunset)" stroke-width="5" />

      <path d="M66 250 C66 246 70 242 74 242 H170 C174 242 178 246 178 250 C178 272 162 286 140 286 H104 C82 286 66 272 66 250 Z" fill="var(--color-surface)" stroke="var(--color-sea-deep)" stroke-width="7" />
      <path d="M122 286 C122 306 122 322 122 336" stroke="var(--color-sea-deep)" stroke-width="7" />
      <path d="M150 208 C150 226 146 236 136 242" stroke="var(--color-sea)" stroke-width="7" />

      <g class="figure">
        <path d="M206 189 C206 212 206 246 206 268" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M206 268 C198 294 192 316 190 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M206 268 C216 294 224 314 228 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M202 208 C186 226 176 246 174 268" stroke="var(--color-ink)" stroke-width="9" />
        <path class="arm-tile" d="M212 206 C244 200 272 190 296 180" stroke="var(--color-ink)" stroke-width="9" />
        <circle cx="206" cy="164" r="25" stroke="var(--color-ink)" stroke-width="9" fill="var(--color-surface)" />
        <use href="#gear-helmet" x="206" y="164"></use>
      </g>
    </g>

    <!-- 3. 누수 파이프 교체 : 천장 배관에서 물이 떨어진다 -->
    <g class="scene scene-3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M62 92 H338" stroke="var(--color-sea)" stroke-width="14" />
      <circle cx="224" cy="92" r="14" stroke="var(--color-sea-deep)" stroke-width="7" fill="var(--color-surface)" />
      <circle class="drop drop-1" cx="224" cy="112" r="8" fill="var(--color-sea)" />
      <circle class="drop drop-2" cx="224" cy="112" r="6" fill="var(--color-sea)" />
      <path d="M196 300 C198 316 200 328 202 336 H246 C248 328 250 316 252 300 Z" fill="var(--color-sea-pale)" stroke="var(--color-sea-deep)" stroke-width="7" />

      <g class="figure">
        <path d="M126 205 C126 228 126 258 126 280" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M126 280 C118 302 112 320 110 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M126 280 C136 302 144 320 148 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M122 224 C104 240 94 260 92 282" stroke="var(--color-ink)" stroke-width="9" />
        <path class="arm-reach" d="M132 222 C158 196 174 156 180 118" stroke="var(--color-ink)" stroke-width="9" />
        <circle cx="126" cy="180" r="25" stroke="var(--color-ink)" stroke-width="9" fill="var(--color-surface)" />
        <use href="#gear-helmet" x="126" y="180"></use>
      </g>
    </g>

    <!-- 4. 보일러 설치 : 벽걸이 보일러를 연결한다 -->
    <g class="scene scene-4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="236" y="118" width="120" height="130" rx="24" fill="var(--color-surface)" stroke="var(--color-sea-deep)" stroke-width="8" />
      <rect x="258" y="142" width="76" height="34" rx="12" fill="var(--color-sea-pale)" stroke="var(--color-sea)" stroke-width="5" />
      <path class="flame" d="M296 222 C282 210 290 194 296 188 C302 194 310 210 296 222 Z" fill="var(--color-sun)" opacity="0.85" />
      <path d="M260 248 C260 268 260 280 260 282 H218" stroke="var(--color-sea)" stroke-width="11" />
      <path d="M332 248 C332 272 332 292 332 300" stroke="var(--color-sea)" stroke-width="11" />

      <g class="figure">
        <path d="M140 197 C140 220 140 252 140 274" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M140 274 C132 296 126 318 124 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M140 274 C150 296 158 316 162 336" stroke="var(--color-ink)" stroke-width="9" />
        <path d="M136 216 C118 232 108 252 106 274" stroke="var(--color-ink)" stroke-width="9" />
        <path class="arm-boiler" d="M146 214 C180 210 208 202 228 194" stroke="var(--color-ink)" stroke-width="9" />
        <circle cx="140" cy="172" r="25" stroke="var(--color-ink)" stroke-width="9" fill="var(--color-surface)" />
        <use href="#gear-helmet" x="140" y="172"></use>
      </g>
    </g>
  </svg>
</div>

<style>
  .worker-scenes {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }

  .worker-scenes svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .scene {
    opacity: 0;
    transform: rotate(-7deg) scale(0.94);
    transform-origin: 200px 210px;
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.22, 0.7, 0.3, 1);
  }
  .scene.is-active {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .scene.is-leaving {
    opacity: 0;
    transform: rotate(7deg) scale(0.94);
  }

  .route {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: draw-route 4.8s ease-in-out infinite;
  }
  @keyframes draw-route {
    0% {
      stroke-dashoffset: 420;
    }
    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .arm-point {
    transform-origin: 144px 210px;
    animation: arm-nudge 3.4s ease-in-out infinite;
  }
  @keyframes arm-nudge {
    0%,
    60%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(-4deg);
    }
  }

  .tile-place {
    animation: tile 4.8s ease-in-out infinite;
  }
  @keyframes tile {
    0%,
    12% {
      opacity: 0;
      transform: translate(10px, -8px);
    }
    32%,
    100% {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  .arm-tile {
    transform-origin: 212px 206px;
    animation: arm-nudge 4.2s ease-in-out infinite;
  }

  .drop {
    opacity: 0;
    animation: drop-fall 2.6s cubic-bezier(0.45, 0, 0.7, 1) infinite;
  }
  .drop-2 {
    animation-delay: 1.3s;
  }
  @keyframes drop-fall {
    0% {
      opacity: 0;
      transform: translateY(0) scaleY(0.8);
    }
    12% {
      opacity: 1;
    }
    70% {
      opacity: 1;
      transform: translateY(178px) scaleY(1.15);
    }
    82%,
    100% {
      opacity: 0;
      transform: translateY(190px) scaleY(0.4);
    }
  }

  .arm-reach {
    transform-origin: 132px 222px;
    animation: arm-nudge 3.8s ease-in-out infinite;
  }

  .flame {
    transform-origin: 296px 222px;
    animation: flame-flicker 2.4s ease-in-out infinite;
  }
  @keyframes flame-flicker {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.75;
    }
    45% {
      transform: scale(1.12) translateY(-2px);
      opacity: 0.95;
    }
  }

  .arm-boiler {
    transform-origin: 146px 214px;
    animation: arm-nudge 3.6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene {
      transition: none;
    }
    .route,
    .arm-point,
    .tile-place,
    .arm-tile,
    .drop,
    .arm-reach,
    .flame,
    .arm-boiler {
      animation: none;
    }
    .route {
      stroke-dashoffset: 0;
    }
    .tile-place {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".worker-scenes").forEach((root) => {
    const scenes = root.querySelectorAll<SVGElement>(".scene");
    if (scenes.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const intervalMs = Number(root.dataset.sceneMs) || 4800;
    let index = 0;

    setInterval(() => {
      const current = scenes[index];
      const next = (index + 1) % scenes.length;

      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      scenes[next].classList.add("is-active");
      setTimeout(() => current.classList.remove("is-leaving"), 750);

      index = next;
    }, intervalMs);
  });
</script>
