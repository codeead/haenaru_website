---
/*
 * 섹션 옆에 붙는 도구 모션. 사람 없이 도구만 나온다.
 *
 * 공통 규칙: 도구는 오른쪽 끝의 가상의 세로선(x = TARGET_X)을 기준으로 작업하고,
 * 그 선을 따라 위 → 중간 → 아래 → 중간 → 위 순서로 오르내리며 각 지점에서 한 번씩 동작한다.
 *   - 렌치: 각 지점에서 너트가 나타나고, 렌치가 조인 뒤 너트가 사라진다
 *   - 그라인더: 날이 돌면서 각 지점에서 불꽃이 튄다
 *   - 용접: 각 지점에서 아크가 한 번씩 터진다
 *
 * 장식이므로 aria-hidden.
 */
interface Props {
  tool: "wrench" | "grinder" | "welder";
  side?: "left" | "right";
  /** 좁은 화면에서 반대쪽으로 보내고 싶을 때 (기본은 side 와 동일) */
  mobileSide?: "left" | "right";
  class?: string;
}

const { tool, side = "right", mobileSide, class: className = "" } = Astro.props;
const narrowSide = mobileSide ?? side;

// 도구가 작업하는 가상의 세로선과 정지 지점
const TARGET_X = 150;
const STOP_MID = 130;

const TOOTH_COUNT = 36;
const BLADE_R = 40;
const teeth = Array.from({ length: TOOTH_COUNT }, (_, i) => {
  const a = (i / TOOTH_COUNT) * Math.PI * 2;
  return {
    x1: TARGET_X - 46 + Math.cos(a) * (BLADE_R - 4),
    y1: STOP_MID + Math.sin(a) * (BLADE_R - 4),
    x2: TARGET_X - 46 + Math.cos(a) * (BLADE_R + 5),
    y2: STOP_MID + Math.sin(a) * (BLADE_R + 5),
  };
});
---

<div class:list={["tool-motion", `side-${side}`, `m-side-${narrowSide}`, `tool-${tool}`, className]} aria-hidden="true">
  <svg viewBox="0 0 180 260" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- C안 감성: 면으로 그리고 부드러운 그림자로 층을 만든다 -->
      <filter id="tool-shadow" x="-40%" y="-40%" width="180%" height="180%">
        <feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="var(--color-deep)" flood-opacity="0.16" />
      </filter>
    </defs>
    <!-- 작업 기준선 (좁은 화면에서는 숨긴다) -->
    <line class="guide" x1={TARGET_X} y1="34" x2={TARGET_X} y2="226" stroke="var(--color-sea-soft)" stroke-width="6" stroke-linecap="round" />

    <g class="rig" filter="url(#tool-shadow)">
      {
        tool === "wrench" && (
          <g stroke-linecap="round" stroke-linejoin="round">
            {/* 조여지는 너트 */}
            <g class="nut">
              <path
                d={`M${TARGET_X} ${STOP_MID - 15} L${TARGET_X + 13} ${STOP_MID - 7.5} L${TARGET_X + 13} ${STOP_MID + 7.5} L${TARGET_X} ${STOP_MID + 15} L${TARGET_X - 13} ${STOP_MID + 7.5} L${TARGET_X - 13} ${STOP_MID - 7.5} Z`}
                fill="var(--color-sea-soft)"
                stroke="var(--color-sea-deep)"
                stroke-width="6"
              />
            </g>
            {/* 렌치: 오른쪽으로 벌어진 물림쇠 + 왼쪽 아래로 뻗은 손잡이 */}
            <g class="wrench-head">
              <path
                d={`M${TARGET_X - 42} ${STOP_MID - 20} L${TARGET_X - 14} ${STOP_MID - 20} L${TARGET_X - 14} ${STOP_MID - 9} L${TARGET_X - 26} ${STOP_MID - 9} L${TARGET_X - 26} ${STOP_MID + 9} L${TARGET_X - 14} ${STOP_MID + 9} L${TARGET_X - 14} ${STOP_MID + 20} L${TARGET_X - 42} ${STOP_MID + 20} Z`}
                fill="var(--color-sea)"
                stroke="var(--color-sea-deep)"
                stroke-width="5"
              />
              <line
                x1={TARGET_X - 40}
                y1={STOP_MID}
                x2={TARGET_X - 108}
                y2={STOP_MID + 40}
                stroke="var(--color-sea)"
                stroke-width="19"
              />
              <line
                x1={TARGET_X - 72}
                y1={STOP_MID + 19}
                x2={TARGET_X - 98}
                y2={STOP_MID + 34}
                stroke="var(--color-sunset)"
                stroke-width="9"
              />
            </g>
          </g>
        )
      }
      {
        tool === "grinder" && (
          <g>
            <g class="blade">
              <circle cx={TARGET_X - 46} cy={STOP_MID} r={BLADE_R} fill="var(--color-sea-soft)" stroke="var(--color-sea)" stroke-width="6" />
              {teeth.map((t) => (
                <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--color-sea-deep)" stroke-width="4" stroke-linecap="round" />
              ))}
              <circle cx={TARGET_X - 46} cy={STOP_MID} r="12" fill="var(--color-surface)" stroke="var(--color-sea-deep)" stroke-width="6" />
            </g>
            <g class="zap">
              <circle class="spark s1" cx={TARGET_X - 14} cy={STOP_MID + 22} r="5" fill="var(--color-sunset)" />
              <circle class="spark s2" cx={TARGET_X - 14} cy={STOP_MID + 22} r="4" fill="var(--color-sun)" />
              <circle class="spark s3" cx={TARGET_X - 14} cy={STOP_MID + 22} r="3.5" fill="var(--color-sunset)" />
            </g>
          </g>
        )
      }
      {
        tool === "welder" && (
          <g stroke-linecap="round" stroke-linejoin="round">
            <path d={`M${TARGET_X - 112} ${STOP_MID + 54} L${TARGET_X - 56} ${STOP_MID + 14}`} stroke="var(--color-deep)" stroke-width="22" />
            <path d={`M${TARGET_X - 100} ${STOP_MID + 40} L${TARGET_X - 80} ${STOP_MID + 26}`} stroke="var(--color-sea-soft)" stroke-width="7" />
            <path d={`M${TARGET_X - 56} ${STOP_MID + 14} L${TARGET_X - 26} ${STOP_MID + 2}`} stroke="var(--color-sea)" stroke-width="13" />
            <g class="zap">
              <circle class="arc-glow" cx={TARGET_X - 8} cy={STOP_MID - 4} r="22" fill="var(--color-sunset-soft)" />
              <circle class="arc-core" cx={TARGET_X - 8} cy={STOP_MID - 4} r="9" fill="var(--color-sun)" />
            </g>
          </g>
        )
      }
    </g>
  </svg>
</div>

<style>
  /*
   * 배치 규칙: 바깥으로 미는 거리 = 도구 너비. 그래야 컨테이너 안으로 한 픽셀도 안 들어온다.
   * --tool-peek 만큼만 되돌려 살짝 보이게 하는데, 그 값은 섹션 좌우 여백(px-4 = 1rem)과 같아서
   * 본문·카드가 아니라 가장자리 여백 위에만 걸친다.
   */
  .tool-motion {
    --tool-w: 11rem;
    --tool-peek: 0rem;
    position: absolute;
    top: 50%;
    width: var(--tool-w);
    opacity: 0.95;
    pointer-events: none;
    transform: translateY(-50%);
  }

  /* 도구 머리(물림쇠·아크)는 항상 본문 쪽을 향하고, 손잡이가 바깥으로 나가 잘린다. */
  .tool-motion.side-right {
    right: calc(var(--tool-peek) - var(--tool-w));
    transform: translateY(-50%) scaleX(-1);
  }
  .tool-motion.side-left {
    left: calc(var(--tool-peek) - var(--tool-w));
  }
  .tool-motion svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 좁은 화면: 기준선을 빼고 도구만 오르내린다. 여백 폭(1rem)만 걸치게 둔다. */
  @media (max-width: 1240px) {
    .tool-motion {
      --tool-w: 8rem;
      --tool-peek: 1rem;
      opacity: 0.5;
    }
    .tool-motion.tool-grinder {
      --tool-w: 6rem;
    }
    .tool-motion.m-side-right {
      right: calc(var(--tool-peek) - var(--tool-w));
      left: auto;
      transform: translateY(-50%) scaleX(-1);
    }
    .tool-motion.m-side-left {
      left: calc(var(--tool-peek) - var(--tool-w));
      right: auto;
      transform: translateY(-50%);
    }
    .guide {
      display: none;
    }
  }

  /*
   * 위 → 중간 → 아래 → 중간 → 위. 각 지점에서 멈춰 한 번 작업한다.
   * (한 주기 12s: 정지 5회 × 약 1.1s + 이동 4회)
   */
  .rig {
    animation: travel 12s ease-in-out infinite;
  }
  @keyframes travel {
    0%,
    9% {
      transform: translateY(-72px);
    }
    16%,
    25% {
      transform: translateY(0px);
    }
    32%,
    41% {
      transform: translateY(72px);
    }
    48%,
    57% {
      transform: translateY(0px);
    }
    64%,
    73% {
      transform: translateY(-72px);
    }
    80%,
    89% {
      transform: translateY(0px);
    }
    96%,
    100% {
      transform: translateY(-72px);
    }
  }

  /* 정지한 순간에만 동작 (뚝딱 / 치지직) */
  .wrench-head {
    transform-origin: 108px 130px;
    animation: tighten 12s ease-in-out infinite;
  }
  @keyframes tighten {
    0%,
    3%,
    12%,
    19%,
    28%,
    35%,
    44%,
    51%,
    60%,
    67%,
    76%,
    83%,
    92%,
    100% {
      transform: rotate(0deg);
    }
    5%,
    21%,
    37%,
    53%,
    69%,
    85% {
      transform: rotate(-17deg);
    }
  }

  .nut {
    opacity: 0;
    animation: nut-cycle 12s ease-in-out infinite;
  }
  @keyframes nut-cycle {
    0%,
    10% {
      opacity: 1;
    }
    12%,
    14% {
      opacity: 0;
    }
    16%,
    26% {
      opacity: 1;
    }
    28%,
    30% {
      opacity: 0;
    }
    32%,
    42% {
      opacity: 1;
    }
    44%,
    46% {
      opacity: 0;
    }
    48%,
    58% {
      opacity: 1;
    }
    60%,
    62% {
      opacity: 0;
    }
    64%,
    74% {
      opacity: 1;
    }
    76%,
    78% {
      opacity: 0;
    }
    80%,
    90% {
      opacity: 1;
    }
    92%,
    100% {
      opacity: 0;
    }
  }

  .blade {
    transform-origin: 104px 130px;
    animation: blade-spin 3.2s linear infinite;
  }
  @keyframes blade-spin {
    to {
      transform: rotate(-360deg);
    }
  }

  .spark {
    opacity: 0;
    animation: spark-fly 12s ease-out infinite;
  }
  .s2 {
    animation-delay: 0.25s;
  }
  .s3 {
    animation-delay: 0.5s;
  }
  @keyframes spark-fly {
    0%,
    16%,
    32%,
    48%,
    64%,
    80% {
      opacity: 0.95;
      transform: translate(0, 0) scale(1);
    }
    8%,
    24%,
    40%,
    56%,
    72%,
    88% {
      opacity: 0;
      transform: translate(-26px, 24px) scale(0.35);
    }
    9%,
    25%,
    41%,
    57%,
    73%,
    89%,
    100% {
      opacity: 0;
      transform: translate(0, 0) scale(1);
    }
  }

  .arc-glow,
  .arc-core {
    transform-origin: 142px 126px;
    animation: arc-zap 12s ease-in-out infinite;
  }
  .arc-core {
    animation-delay: 0.08s;
  }
  @keyframes arc-zap {
    0%,
    6%,
    16%,
    22%,
    32%,
    38%,
    48%,
    54%,
    64%,
    70%,
    80%,
    86%,
    100% {
      opacity: 0.28;
      transform: scale(0.72);
    }
    3%,
    19%,
    35%,
    51%,
    67%,
    83% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rig,
    .wrench-head,
    .nut,
    .blade,
    .spark,
    .arc-glow,
    .arc-core {
      animation: none;
    }
    .nut,
    .spark {
      opacity: 0.8;
    }
    .arc-glow,
    .arc-core {
      opacity: 0.6;
    }
  }
</style>
