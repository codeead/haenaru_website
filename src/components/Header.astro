---
import { Image } from "astro:assets";
import symbol from "@/assets/brand/symbol.png";
import wordmark from "@/assets/brand/wordmark.png";
import { siteConfig } from "@/lib/site";

const navItems = [
  { href: "/about", label: "회사소개" },
  { href: "/services", label: "서비스" },
  { href: "/works", label: "수리 이력" },
  { href: "/location", label: "오시는 길" },
  { href: "/contact", label: "문의" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-surface/80 backdrop-blur-md supports-[backdrop-filter]:bg-surface/60"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2 rounded-md transition-transform active:scale-[0.97]"
      aria-label={`${siteConfig.companyName} 홈으로 이동`}
    >
      <Image src={symbol} alt="" width={36} height={36} class="h-9 w-9" />
      <span class="flex items-baseline gap-1.5">
        <Image src={wordmark} alt={siteConfig.companyName} width={92} height={63} class="h-6 w-auto" />
        <span class="text-sm font-semibold tracking-tight text-foreground">종합설비</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex">
      {
        navItems.map((item) => {
          const active = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors active:scale-[0.97]",
                active
                  ? "text-primary"
                  : "text-foreground-muted hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`tel:${siteConfig.mobile}`}
        class="hidden rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-transform active:scale-[0.97] sm:inline-flex"
      >
        전화 문의
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-foreground transition-transform active:scale-[0.97] sm:hidden"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border/70 px-4 py-2 sm:hidden">
    {
      navItems.map((item) => (
        <a href={item.href} class="block rounded-md px-2 py-2.5 text-base font-medium text-foreground">
          {item.label}
        </a>
      ))
    }
    <a href={`tel:${siteConfig.mobile}`} class="mt-1 block rounded-md bg-primary px-2 py-2.5 text-center text-base font-semibold text-primary-foreground">
      전화 문의
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
