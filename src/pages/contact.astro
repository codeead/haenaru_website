---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KakaoChannelButton from "@/components/KakaoChannelButton.astro";
import { siteConfig } from "@/lib/site";
---

<BaseLayout title="문의" description="전화 또는 카카오톡 채널로 문의해 주세요">
  <section class="mx-auto max-w-xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <p class="text-sm font-medium text-primary">문의</p>
    <h1 class="mt-2 text-[clamp(1.5rem,4vw,2.25rem)] font-bold tracking-[-0.02em] text-foreground">
      편하신 방법으로 연락해 주세요
    </h1>
    <p class="mt-3 text-base leading-relaxed text-foreground-muted">
      전화 또는 카카오톡 채널로 바로 상담 받으실 수 있습니다.
    </p>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href={`tel:${siteConfig.mobile}`}
        class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 text-base font-semibold text-primary-foreground shadow-sm transition-transform active:scale-[0.97] sm:w-auto"
      >
        전화 걸기 ({siteConfig.mobile})
      </a>
      <KakaoChannelButton label="카카오톡 문의" class="w-full px-6 py-3.5 text-base sm:w-auto" />
    </div>

    <p class="mt-8 text-sm text-foreground-muted">{siteConfig.businessHours}</p>
  </section>
</BaseLayout>
