---
import { Image } from "astro:assets";
import heroPhoto from "@/assets/hero/main.jpg";
import KakaoChannelButton from "@/components/KakaoChannelButton.astro";
import { siteConfig } from "@/lib/site";

/*
 * 히어로는 왼쪽이 가장 옅고 오른쪽 끝으로 갈수록 짙어지는 '하나의 연속된 면'이다.
 * 사진은 카드가 아니라 오른쪽 위아래를 꽉 채우고, 왼쪽 가장자리는 마스크로 서서히 사라져
 * 배경과 이어진다. 사진 자리 전체가 시공 기록으로 가는 링크이고,
 * 안내 문구는 평소에 숨어 있다가 커서를 올리면 나타난다.
 *
 * 사진 교체: src/assets/hero/main.jpg 파일만 덮어쓰면 된다 (같은 폴더 README 참고).
 */
---

<section class="hero">
  <a href="/works" class="photo" aria-label="시공 기록 전체 보기">
    <Image
      src={heroPhoto}
      alt=""
      widths={[560, 1000, 1500]}
      sizes="(min-width: 768px) 62vw, 100vw"
      class="photo-img"
      loading="eager"
      fetchpriority="high"
    />
    <span class="photo-tint"></span>
    <span class="photo-cta">
      <span class="photo-cta-label">시공 기록 전체 보기</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </a>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">충남 당진시 대덕동 · 난방시공업2종 · 가스시설시공업3종</p>
      <h1 class="headline">보일러가 고장 나면<br />언제든 전화 주세요</h1>
      <p class="lede">
        당진에서 배관·보일러·난방을 고칩니다.<br />
        대표 {siteConfig.ceoName}이 직접 나갑니다.
      </p>
      <div class="actions">
        <a href={`tel:${siteConfig.mobile}`} class="btn-primary">전화 걸기</a>
        <KakaoChannelButton label="카카오톡 문의" always />
      </div>
    </div>
  </div>

  <a href="#services" class="scroll-cue" aria-label="아래 내용 보기">
    <svg width="30" height="34" viewBox="0 0 30 34" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path class="chev chev-1" d="M7 10l8 8 8-8" />
      <path class="chev chev-2" d="M7 20l8 8 8-8" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(calc(100svh - 4rem), 44rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    scroll-margin-top: 4rem;
    /* 왼쪽은 페이지 바탕, 오른쪽 끝으로 갈수록 짙어진다 */
    background: linear-gradient(
      90deg,
      var(--color-sea-pale) 0%,
      var(--color-sea-pale) 34%,
      color-mix(in srgb, var(--color-sea-soft) 70%, var(--color-sea-pale)) 62%,
      var(--color-sea-soft) 82%,
      color-mix(in srgb, var(--color-sea) 32%, var(--color-sea-soft)) 100%
    );
  }

  /* ── 사진: 오른쪽 위아래를 꽉 채우고 왼쪽으로 사라진다 ── */
  .photo {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: min(62%, 54rem);
    display: block;
    /* 왼쪽 가장자리를 부드럽게 지워 배경과 이어 붙인다 */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.45) 26%, #000 58%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.45) 26%, #000 58%);
  }

  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 900ms cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  /* 같은 계열의 유리막. 오른쪽 끝이 가장 짙다. */
  .photo-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-sea-pale) 88%, transparent) 0%,
      color-mix(in srgb, var(--color-sea-soft) 46%, transparent) 34%,
      color-mix(in srgb, var(--color-sea) 34%, transparent) 68%,
      color-mix(in srgb, var(--color-sea-deep) 52%, transparent) 100%
    );
    backdrop-filter: saturate(0.82);
    transition: opacity 500ms ease;
  }

  /* 평소엔 숨어 있다가 커서를 올리면 나타난다 */
  .photo-cta {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(1.5rem, 4vw, 2.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-deep) 55%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-on-deep);
    font-size: 0.9375rem;
    font-weight: 700;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 320ms ease,
      transform 320ms cubic-bezier(0.22, 0.7, 0.3, 1);
  }
  .photo-cta svg {
    transition: transform 320ms cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  @media (hover: hover) {
    .photo:hover .photo-cta {
      opacity: 1;
      transform: translateY(0);
    }
    .photo:hover .photo-cta svg {
      transform: translateX(4px);
    }
    .photo:hover :global(.photo-img) {
      transform: scale(1.03);
    }
    .photo:hover .photo-tint {
      opacity: 0.82;
    }
  }
  /* 키보드 사용자에게도 같은 안내가 보이도록 */
  .photo:focus-visible .photo-cta {
    opacity: 1;
    transform: translateY(0);
  }
  /* 터치 기기에는 hover가 없으니 항상 보인다 */
  @media (hover: none) {
    .photo-cta {
      opacity: 1;
      transform: none;
    }
  }

  /* ── 글 ─────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 640px) {
    .hero-inner {
      padding-inline: 1.5rem;
    }
  }

  .hero-copy {
    max-width: 32rem;
  }

  .eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-sea-deep);
  }

  .headline {
    margin-top: var(--space-tight);
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 5.6vw, 3.5rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .lede {
    margin-top: var(--space-snug);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-ink-muted);
  }

  .actions {
    margin-top: var(--space-normal);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transition: transform 160ms ease;
  }
  .btn-primary:active {
    transform: scale(0.97);
  }

  /* ── 스크롤 안내 ──────────────────────────────────────── */
  .scroll-cue {
    position: absolute;
    bottom: 1.5rem;
    left: clamp(1.5rem, 8vw, 7rem);
    display: inline-flex;
    padding: 0.5rem 0.75rem;
    color: var(--color-sea-deep);
    text-decoration: none;
    transition: transform 160ms ease;
  }
  .scroll-cue:active {
    transform: scale(0.94);
  }

  .chev {
    animation: chev-flow 2.4s ease-in-out infinite;
  }
  .chev-2 {
    animation-delay: 0.18s;
  }
  @keyframes chev-flow {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(-2px);
    }
    45% {
      opacity: 1;
      transform: translateY(3px);
    }
  }

  /* ── 좁은 화면: 사진이 위쪽을 채우고 아래로 사라진다 ── */
  @media (max-width: 767px) {
    .hero {
      align-items: flex-end;
      padding-block: 0 4.5rem;
      background: linear-gradient(
        180deg,
        var(--color-sea-soft) 0%,
        color-mix(in srgb, var(--color-sea-soft) 50%, var(--color-sea-pale)) 42%,
        var(--color-sea-pale) 70%
      );
    }
    .photo {
      inset-block: 0 auto;
      right: 0;
      left: 0;
      width: 100%;
      height: 46svh;
      -webkit-mask-image: linear-gradient(180deg, #000 52%, rgb(0 0 0 / 0.4) 82%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 52%, rgb(0 0 0 / 0.4) 82%, transparent 100%);
    }
    .photo-tint {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-sea-deep) 34%, transparent) 0%,
        color-mix(in srgb, var(--color-sea) 22%, transparent) 45%,
        color-mix(in srgb, var(--color-sea-pale) 70%, transparent) 100%
      );
    }
    .photo-cta {
      right: 1rem;
      bottom: auto;
      top: 1rem;
    }
    .hero-inner {
      padding-top: 48svh;
    }
    .hero-copy {
      max-width: none;
      text-align: center;
    }
    .actions {
      justify-content: center;
    }
    .scroll-cue {
      left: 50%;
      transform: translateX(-50%);
    }
    .scroll-cue:active {
      transform: translateX(-50%) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chev {
      animation: none;
      opacity: 0.8;
    }
    .photo :global(.photo-img),
    .photo-tint,
    .photo-cta,
    .photo-cta svg {
      transition: none;
    }
  }
</style>
