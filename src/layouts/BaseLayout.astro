---
import "@/styles/globals.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteConfig } from "@/lib/site";
import { services } from "@/content/services";

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteConfig.tagline } = Astro.props;
const pageTitle = `${title} | ${siteConfig.companyName}`;
const ogImage = new URL("/og-image.png", Astro.site ?? "https://haenarueng.com").href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://haenarueng.com").href;

/*
 * 지역업체 구조화 데이터. 검색 결과에 상호·전화·주소·영업시간이 직접 노출되게 한다.
 * 값은 전부 site/config.json 하나에서 온다 — CMS에서 전화번호를 고치면 여기도 같이 바뀐다.
 */
const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "Plumber",
  name: siteConfig.companyName,
  description,
  url: canonical,
  image: ogImage,
  telephone: siteConfig.mobile,
  founder: siteConfig.ceoName,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address,
    addressLocality: "당진시",
    addressRegion: "충청남도",
    addressCountry: "KR",
  },
  areaServed: { "@type": "City", name: "당진시" },
  openingHours: "Mo-Fr 09:00-18:00",
  makesOffer: services.map((service) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: service.title },
  })),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={siteConfig.companyName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f9f8f5" />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
