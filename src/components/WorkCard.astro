---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getServiceByKey } from "@/content/services";

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { title, category, workedAt, locationRegion, coverImage } = work.data;
const categoryLabel = getServiceByKey(category)?.title ?? category;
const dateLabel = workedAt.toLocaleDateString("ko-KR", { year: "numeric", month: "long" });
---

<a
  href={`/works/${work.id}/`}
  class="group block overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition-transform active:scale-[0.98]"
>
  <div class="aspect-[4/3] overflow-hidden bg-border">
    <Image
      src={coverImage}
      alt={title}
      width={480}
      height={360}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-4">
    <span class="text-xs font-medium text-primary">{categoryLabel}</span>
    <h3 class="mt-1 text-base font-semibold leading-snug text-foreground">{title}</h3>
    <p class="mt-1.5 text-sm text-foreground-muted">{locationRegion} · {dateLabel}</p>
  </div>
</a>
