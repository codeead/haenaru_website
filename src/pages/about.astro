---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { aboutParagraphs } from "@/content/about";
import { siteConfig } from "@/lib/site";
---

<BaseLayout title="회사소개" description={`${siteConfig.companyName} 소개`}>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm font-medium text-primary">회사소개</p>
    <h1 class="mt-2 text-[clamp(1.5rem,4vw,2.25rem)] font-bold tracking-[-0.02em] text-foreground">
      {siteConfig.companyName}
    </h1>
    <div class="mt-8 space-y-5">
      {aboutParagraphs.map((p) => <p class="text-base leading-[1.8] text-foreground-muted">{p}</p>)}
    </div>

    <dl class="mt-10 grid gap-4 rounded-lg border border-border bg-surface p-6 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-foreground-muted">대표</dt>
        <dd class="mt-0.5 font-medium text-foreground">{siteConfig.ceoName}</dd>
      </div>
      <div>
        <dt class="text-foreground-muted">등록업체</dt>
        <dd class="mt-0.5 font-medium text-foreground">{siteConfig.registrations.join(", ")}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-foreground-muted">위치</dt>
        <dd class="mt-0.5 font-medium text-foreground">{siteConfig.address}</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
