---
import ToolMotion from "@/components/ToolMotion.astro";
import KakaoChannelButton from "@/components/KakaoChannelButton.astro";
import { siteConfig } from "@/lib/site";
---

<section id="contact-cta" class="relative overflow-hidden bg-sea-pale">
  <div class="section relative mx-auto max-w-5xl px-4 sm:px-6">
    <ToolMotion tool="welder" side="left" />

    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-[0.02em] text-sea-deep">문의</p>
      <h2 class="mt-1.5 font-display text-2xl leading-snug text-ink sm:text-3xl">
        전화 주세요
      </h2>
      <p class="mt-4 text-base leading-[1.9] text-ink-muted">
        {siteConfig.businessHours}입니다.
      </p>

      <a
        href={`tel:${siteConfig.mobile}`}
        class="mt-8 inline-block text-[clamp(1.75rem,5vw,2.5rem)] font-bold tracking-[-0.02em] text-ink hover:text-sea-deep"
      >
        {siteConfig.mobile}
      </a>

      <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href={`tel:${siteConfig.mobile}`}
          class="inline-flex w-full items-center justify-center rounded-full bg-primary px-7 py-3.5 text-base font-bold text-primary-foreground shadow-sm transition-transform active:scale-[0.97] sm:w-auto"
        >
          전화 걸기
        </a>
        <KakaoChannelButton label="카카오톡 문의" class="w-full px-7 py-3.5 text-base sm:w-auto" always />
      </div>
    </div>
  </div>
</section>
