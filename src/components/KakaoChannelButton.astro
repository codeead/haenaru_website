---
import { siteConfig } from "@/lib/site";

interface Props {
  label?: string;
  class?: string;
}

const { label = "카카오톡 문의", class: className = "" } = Astro.props;
const hasChannel = siteConfig.kakaoChannelUrl.trim().length > 0;
---

{
  hasChannel ? (
    <a
      href={siteConfig.kakaoChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "inline-flex items-center justify-center gap-2 rounded-full bg-[#FEE500] px-5 py-3 text-sm font-semibold text-[#3C1E1E] shadow-sm transition-transform active:scale-[0.97]",
        className,
      ]}
    >
      {label}
    </a>
  ) : (
    <a
      href={`tel:${siteConfig.mobile}`}
      class:list={[
        "inline-flex items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-transform active:scale-[0.97]",
        className,
      ]}
      title="카카오톡 채널 준비 중 — 우선 전화로 문의해 주세요"
    >
      전화 문의 ({siteConfig.mobile})
    </a>
  )
}
